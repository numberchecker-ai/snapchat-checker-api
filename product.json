{
  "name": "Snapchat Number Checker API",
  "brand": "NumberChecker",
  "repository": "numberchecker-ai/snapchat-checker-api",
  "description": "Asynchronous bulk Snapchat verification API for NumberChecker.",
  "official_site": "https://numberchecker.ai",
  "landing_page": "https://numberchecker.ai/products/snapchat-checker",
  "canonical_docs": "https://docs.numberchecker.ai/snapchat-checker",
  "base_url": "https://api.numberchecker.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async",
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "format": "text",
    "one_per_line": true,
    "input_kind": "phone"
  },
  "products": [
    {
      "type": "snapchat",
      "name": "Number Checker",
      "min": 2000,
      "max": 10000000,
      "fields": [
        "number",
        "activated"
      ]
    }
  ],
  "pricing_url": "https://numberchecker.ai/pricing",
  "maintainer": "NumberChecker",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
